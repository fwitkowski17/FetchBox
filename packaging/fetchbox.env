# Settings of the FetchBox service (read by systemd). Restart after a change: systemctl restart fetchbox
# A value must not be empty: leave a setting commented out to keep its default.
#
# A fixed password (at least 8 characters). Leave it unset to create the account in the browser
# on first run, with the setup code from `journalctl -u fetchbox | grep 'setup code'`. A password
# set here wins and cannot be changed in the web interface.
#FETCHBOX_PASSWORD=
#
# Port to listen on (default 8080).
#FETCHBOX_PORT=8080
#
# Where downloads go (default /var/lib/fetchbox/downloads). The folder must be writable for the
# user "fetchbox": chown fetchbox: /mnt/nas/downloads
#FETCHBOX_DOWNLOAD_DIR=/mnt/nas/downloads
#
# Refuse links to loopback, private and link-local addresses (SSRF protection). Switch it on when
# the manager is reachable from outside your network.
#FETCHBOX_BLOCK_PRIVATE_URLS=true
#
# How FetchBox was installed: decides which steps the update notice in the web app shows. The
# service sets it already; change it only if the notice shows the wrong ones.
# One of: docker, package, lxc, script, source.
#FETCHBOX_INSTALL_METHOD=package
#
# Log every download, settings change and sign-in to the journal.
#FETCHBOX_LOG_ACTIVITY=true
#
# Log level of everything else, e.g. debug.
#RUST_LOG=info
