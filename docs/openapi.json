{
  "openapi": "3.1.0",
  "info": {
    "title": "dlmanager API",
    "description": "Self-hosted download manager. Commands over REST, live updates over SSE.\n\nEverything except `/api/health`, `/api/openapi.json` and `/api/auth/*` needs a session: log in with `POST /api/auth/login` (sets the `dlm_session` cookie) or send the returned token as `Authorization: Bearer`.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in and start a session.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; sets the `dlm_session` cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts (5 per minute); see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockedBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session (idempotent) and clear the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session ended"
          }
        }
      }
    },
    "/api/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Change the password of an account created in the UI.",
        "description": "Ends every other session. Not available for a password from the environment or a file.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "New password too short or too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Wrong current password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The password is managed outside the UI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts (5 per minute); see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockedBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/auth/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create the account on first run and log in.",
        "description": "Only possible while `setup_required` is true; the code comes from the server log.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created and logged in; sets the `dlm_session` cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Password too short or too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Wrong setup code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Setup already done, or authentication is configured externally",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts (5 per minute); see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockedBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Whether login is required and whether the caller is already logged in.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/disk": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Free space on the disk that holds the download directory, and how much of it the running\ndownloads still have to write.",
        "operationId": "disk",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiskSpace"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/downloads": {
      "get": {
        "tags": [
          "downloads"
        ],
        "summary": "All downloads, newest first. Running downloads carry live `downloaded` and `speed`.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Download"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "Add a download by URL.",
        "description": "If the URL, the file name or a reserved name collides with something, the server answers\n`409` with a `conflict` description and changes nothing. Re-send the request with\n`on_conflict` set to `rename` (uses `conflict.suggested_name`) or `overwrite` (replaces the\nexisting file once the download finishes) to proceed. Not re-sending cancels the add.",
        "operationId": "add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Download created (queued or started)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, or overwrite of a name another download is still producing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Collision; the user must choose",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictBody"
                }
              }
            }
          },
          "502": {
            "description": "The remote server could not be reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "507": {
            "description": "The file does not fit into the free disk space that the running downloads have not claimed. Send the request again with `ignore_space` to add it anyway.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/downloads/{id}": {
      "delete": {
        "tags": [
          "downloads"
        ],
        "summary": "Remove a download from the list (cancels it first when still active).\nA finished file stays on disk unless `delete_file=true`.",
        "operationId": "remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "delete_file",
            "in": "path",
            "description": "Also delete the finished file from the disk. Ignored for downloads that have not\ncompleted (their partial file is always removed).",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "The file could not be deleted; the entry is kept so it can be retried",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "downloads"
        ],
        "summary": "Change the category of a download and/or archive it (hide it from the main list).",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDownload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "400": {
            "description": "Nothing to update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Only finished downloads can be archived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/downloads/{id}/cancel": {
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "Cancel a download and delete its partial file.",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Already finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/downloads/{id}/pause": {
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "Pause a queued or running download; offsets are saved so it can resume.",
        "operationId": "pause",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Not queued or downloading",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/downloads/{id}/resume": {
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "Resume a paused (or retry a failed) download.",
        "operationId": "resume",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Not paused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Live updates as server-sent events.",
        "description": "Each SSE message has an `event:` name (`download`, `progress`, `removed`, `settings`, or\n`resync` with empty data) and a JSON `data:` payload shaped like [`Event`]. After `resync`\n(this client fell behind) reload the list with `GET /api/downloads`. Subscribe before\nfetching the list so nothing in between is lost.",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe (public).",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Current settings.",
        "operationId": "get_settings",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Replace the settings. Speed limits and `max_concurrent` apply to running downloads\nimmediately; `connections` applies to downloads started afterwards. `0` speed = unlimited.",
        "operationId": "put_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddRequest": {
        "type": "object",
        "description": "Request to add a download by URL.",
        "required": [
          "url"
        ],
        "properties": {
          "category": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Category",
                "description": "Override the category detected from the file name."
              }
            ]
          },
          "filename": {
            "type": [
              "string",
              "null"
            ],
            "description": "Override the file name suggested by the server."
          },
          "ignore_space": {
            "type": "boolean",
            "description": "Add the download even though it does not fit into the free space left after the space\nreserved by running downloads (`507` otherwise). The user's call: files may be moved away\nor deleted before it starts. If it still does not fit when it starts, it fails then."
          },
          "on_conflict": {
            "$ref": "#/components/schemas/OnConflict"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "AuthStatus": {
        "type": "object",
        "description": "What the UI needs to decide whether to show the login screen.",
        "required": [
          "auth_required",
          "authenticated",
          "setup_required",
          "can_change_password"
        ],
        "properties": {
          "auth_required": {
            "type": "boolean",
            "description": "A password is configured; unauthenticated requests are refused."
          },
          "authenticated": {
            "type": "boolean",
            "description": "The caller's session (or the disabled auth) lets it through."
          },
          "can_change_password": {
            "type": "boolean",
            "description": "The password was created in the UI and can be changed (`POST /api/auth/password`);\nfalse for a password from `DLM_PASSWORD` / `--password-file`."
          },
          "setup_required": {
            "type": "boolean",
            "description": "No account exists yet: show the first-run setup (`POST /api/auth/setup`)."
          }
        }
      },
      "Category": {
        "type": "string",
        "description": "File category, auto-detected from extension and changeable by the user.",
        "enum": [
          "photo",
          "music",
          "video",
          "program",
          "archive",
          "other"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "description": "Password change.",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "description": "At least 8 characters."
          }
        }
      },
      "Conflict": {
        "type": "object",
        "description": "Description of a collision, shown to the user so they can choose.",
        "required": [
          "kind",
          "existing_name",
          "suggested_name"
        ],
        "properties": {
          "existing_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The existing download, when the collision is with one."
          },
          "existing_modified": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Unix seconds, for files already on disk."
          },
          "existing_name": {
            "type": "string"
          },
          "existing_size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/ConflictKind"
          },
          "suggested_name": {
            "type": "string",
            "description": "First free name, used by `OnConflict::Rename`."
          }
        }
      },
      "ConflictBody": {
        "type": "object",
        "description": "`409` body of `POST /downloads` when the new download collides with an existing one.\nThe UI shows `conflict` and re-sends the request with `on_conflict` set.",
        "required": [
          "error",
          "conflict"
        ],
        "properties": {
          "conflict": {
            "$ref": "#/components/schemas/Conflict"
          },
          "error": {
            "type": "string",
            "description": "Always `\"conflict\"`."
          }
        }
      },
      "ConflictKind": {
        "type": "string",
        "description": "Why an add request collided with something.",
        "enum": [
          "duplicate_url",
          "file_exists",
          "name_reserved"
        ]
      },
      "DiskSpace": {
        "type": "object",
        "description": "Free space on the file system that holds the download directory.",
        "required": [
          "total",
          "available",
          "reserved"
        ],
        "properties": {
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes available for new files.",
            "minimum": 0
          },
          "reserved": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes reserved by running downloads: what they still have to write on this file system\n(size known). Queued, paused and held downloads reserve nothing. New downloads must fit into\n`available - reserved`; when `reserved` exceeds `available` (something else filled the disk)\nthe queue will not fit.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes this program can use on the file system: what is used plus what is available\n(blocks reserved for root are not counted, like `df`'s `Use%`).",
            "minimum": 0
          }
        }
      },
      "Download": {
        "type": "object",
        "description": "A download as stored and shown to the user.",
        "required": [
          "id",
          "url",
          "filename",
          "category",
          "status",
          "downloaded",
          "source_kind",
          "resumable"
        ],
        "properties": {
          "archived": {
            "type": "boolean",
            "description": "Hidden from the main list (only finished, failed or cancelled downloads can be archived).\nThe file, if any, stays where it is."
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "downloaded": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "resumable": {
            "type": "boolean"
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Total size in bytes, if known.",
            "minimum": 0
          },
          "source_kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "speed": {
            "type": "integer",
            "format": "int64",
            "description": "Current speed in bytes/s. Not persisted: filled in for running downloads.",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "subdir": {
            "type": "string",
            "description": "Subdirectory of the download directory the file goes to; empty = the directory itself."
          },
          "url": {
            "type": "string"
          },
          "waiting_space": {
            "type": "boolean",
            "description": "Held back because the file does not fit on the disk: it was added on purpose but not\nstarted (status `paused`). Free some space and resume it."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body used by every non-2xx response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "description": "A download was created or its status/metadata changed.",
            "required": [
              "download",
              "type"
            ],
            "properties": {
              "download": {
                "$ref": "#/components/schemas/Download"
              },
              "type": {
                "type": "string",
                "enum": [
                  "download"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Periodic progress of a running download.",
            "required": [
              "id",
              "downloaded",
              "speed",
              "type"
            ],
            "properties": {
              "downloaded": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "speed": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "progress"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A download was removed from the list.",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "removed"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Settings changed.",
            "required": [
              "settings",
              "type"
            ],
            "properties": {
              "settings": {
                "$ref": "#/components/schemas/Settings"
              },
              "type": {
                "type": "string",
                "enum": [
                  "settings"
                ]
              }
            }
          }
        ],
        "description": "Live updates pushed to the UI (SSE)."
      },
      "Health": {
        "type": "object",
        "description": "Liveness probe.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"`."
          }
        }
      },
      "LockedBody": {
        "type": "object",
        "description": "Too many failed logins.",
        "required": [
          "error",
          "retry_after"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "retry_after": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the next attempt is allowed.",
            "minimum": 0
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Login request.",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "description": "Successful login. The same token is also set as the `dlm_session` cookie.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Session token, usable as `Authorization: Bearer <token>`. Empty when auth is disabled."
          }
        }
      },
      "OnConflict": {
        "type": "string",
        "description": "What to do when a new download collides with an existing one (SPEC: name conflicts).",
        "enum": [
          "reject",
          "rename",
          "overwrite"
        ]
      },
      "Settings": {
        "type": "object",
        "description": "Global settings, applied live (SPEC 2, 6.3). Zero speed limit means unlimited.",
        "required": [
          "connections",
          "max_concurrent",
          "speed_per_download",
          "speed_global"
        ],
        "properties": {
          "category_subdirs": {
            "type": "boolean",
            "description": "Put new downloads into a subdirectory named after their category (`video/`, `music/`, ...).\nExisting downloads keep the directory they were created with."
          },
          "connections": {
            "type": "integer",
            "format": "int32",
            "description": "Connections (segments) per download.",
            "minimum": 0
          },
          "max_concurrent": {
            "type": "integer",
            "format": "int32",
            "description": "Max simultaneously running downloads; extra ones are `Queued`.",
            "minimum": 0
          },
          "speed_global": {
            "type": "integer",
            "format": "int64",
            "description": "Global speed limit, bytes/s.",
            "minimum": 0
          },
          "speed_per_download": {
            "type": "integer",
            "format": "int64",
            "description": "Speed limit per download, bytes/s.",
            "minimum": 0
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "description": "First-run account creation.",
        "required": [
          "code",
          "password"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "One-time code printed in the server log at startup (case and dashes are ignored)."
          },
          "password": {
            "type": "string",
            "description": "The new password, at least 8 characters."
          }
        }
      },
      "SourceKind": {
        "type": "string",
        "description": "What kind of source a download comes from.",
        "enum": [
          "http",
          "magnet",
          "torrent_file"
        ]
      },
      "SpaceBody": {
        "type": "object",
        "description": "`507` body of `POST /downloads` when the file does not fit. The UI explains the numbers and\noffers to add the download anyway (`ignore_space`).",
        "required": [
          "error",
          "needed",
          "free",
          "reserved"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"insufficient storage\"`."
          },
          "free": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes free on the disk.",
            "minimum": 0
          },
          "needed": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes the download needs.",
            "minimum": 0
          },
          "reserved": {
            "type": "integer",
            "format": "int64",
            "description": "Part of `free` that the running downloads still have to write. The download fits when\n`needed <= free - reserved`.",
            "minimum": 0
          }
        }
      },
      "Status": {
        "type": "string",
        "description": "Lifecycle status of a download.",
        "enum": [
          "queued",
          "downloading",
          "paused",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "UpdateDownload": {
        "type": "object",
        "description": "Body of `PATCH /downloads/{id}`.",
        "properties": {
          "archived": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Hide the download from the main list (`true`) or bring it back (`false`). Only finished,\nfailed or cancelled downloads can be archived (`409` otherwise)."
          },
          "category": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Category",
                "description": "New category (manual override of the detected one)."
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dlm_session"
      }
    }
  },
  "tags": [
    {
      "name": "downloads",
      "description": "Download list and per-download commands"
    },
    {
      "name": "settings",
      "description": "Global settings, applied live"
    },
    {
      "name": "events",
      "description": "Server-sent events"
    },
    {
      "name": "auth",
      "description": "Single-user login, first-run setup, password change"
    },
    {
      "name": "system",
      "description": "Health"
    }
  ]
}
